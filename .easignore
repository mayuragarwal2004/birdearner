# Dependencies — reinstalled on EAS
node_modules/

# Git history (not needed for build)
.git/

# Expo / Metro caches
.expo/
dist/
web-build/
.metro-health-check*

# Native build artifacts — CocoaPods/Gradle reinstall on EAS
ios/Pods/
ios/build/
android/.gradle/
android/app/build/
android/build/
android/app/.cxx/

# Local Android project (EAS regenerates / you already ignore for upload weight)
android/

# Credentials & secrets (EAS injects these; keep GoogleService files OUT of this list)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env
.env*.local

# Debug / IDE / OS
.idea/
.vscode/
.DS_Store
*.orig.*
npm-debug.*
yarn-debug.*
yarn-error.*
*.tsbuildinfo
eas-build.log
*.log

# Large local junk that must never ship
%ProgramData%/
*.aab
*.apk
*.ipa
build-*.aab
build-*.apk
build-*.ipa
/*.aab
/*.apk
/*.ipa
